# Copy this file to .env for local development

# Server
NODE_ENV=production
PORT=5000

# CORS — set to your Netlify domain so the browser allows cross-origin requests
FRONTEND_URL=https://standingrockstewards.com

# (Optional) Resend email API key for alert notifications
RESEND_API_KEY=re_your_key_here

# ── Brick 10f: TOTP 2FA ────────────────────────────────────────────────────────
# Required for 2FA enrollment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set on Render as an environment variable. NEVER commit the actual value.
# If unset, POST /auth/2fa/setup returns 503 (fail-closed).
TOTP_ENCRYPTION_KEY=

# ── Brick 10h: Client Data Vault ───────────────────────────────────────────────
# Required for encrypting/decrypting sensitive property fields (alarm codes,
# gate codes, access notes, key locations, address). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set as an environment variable on Render. NEVER commit the actual value.
# If unset, PUT /vault returns 503 (fail-closed on write).
# If unset, GET /vault returns 503 (fail-closed on read).
DATA_VAULT_KEY=
