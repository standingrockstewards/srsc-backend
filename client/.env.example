# ── SRSC Client Environment Variables ─────────────────────────────────────────
# Copy this file to .env and adjust for your environment.
# NEVER commit .env to version control.

# Required: v2 API base URL (no trailing slash)
# Development:  http://localhost:3001/api/v2
# Production:   https://srsc-backend.onrender.com/api/v2
VITE_API_BASE=https://srsc-backend.onrender.com/api/v2

# Optional: If a tile/map provider API key is ever required (currently using
# OpenStreetMap free tiles — no key needed). Add here if switching providers.
# VITE_MAP_PROVIDER_KEY=
